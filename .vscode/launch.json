{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (API)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: api",
            "program": "${workspaceFolder}/1-Presentation/MotorcycleRAG.API/bin/Debug/net10.0/MotorcycleRAG.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/1-Presentation/MotorcycleRAG.API",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https://\\S+)",
                "uriFormat": "%s/index.html"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7215"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Launch (API, no browser)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: api",
            "program": "${workspaceFolder}/1-Presentation/MotorcycleRAG.API/bin/Debug/net10.0/MotorcycleRAG.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/1-Presentation/MotorcycleRAG.API",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7215"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Launch (BFF)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: bff",
            "program": "${workspaceFolder}/1-Presentation/MotorcycleRag.WebUI.BFF/bin/Debug/net10.0/MotorcycleRag.WebUI.BFF.dll",
            "args": [],
            "cwd": "${workspaceFolder}/1-Presentation/MotorcycleRag.WebUI.BFF",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7216;http://localhost:5216"
            }
        },
        {
            "name": ".NET Core Launch (BFF, no browser)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: bff",
            "program": "${workspaceFolder}/1-Presentation/MotorcycleRag.WebUI.BFF/bin/Debug/net10.0/MotorcycleRag.WebUI.BFF.dll",
            "args": [],
            "cwd": "${workspaceFolder}/1-Presentation/MotorcycleRag.WebUI.BFF",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7216;http://localhost:5216"
            }
        },
        {
            "name": "Chrome: Launch WebUI",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:5173",
            "webRoot": "${workspaceFolder}/1-Presentation/MotorcycleRag.WebUI",
            "preLaunchTask": "npm: dev"
        },
        {
            "name": "Tauri: Admin Desktop (Dev)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri dev",
            "cwd": "${workspaceFolder}/1-Presentation/MotorcycleRAG.AdminDesktop"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "WebUI + BFF + API",
            "configurations": [
                ".NET Core Launch (API, no browser)",
                ".NET Core Launch (BFF, no browser)",
                "Chrome: Launch WebUI"
            ],
            "preLaunchTask": "build: full-stack",
            "stopAll": true
        },
        {
            "name": "Admin Desktop + API",
            "configurations": [
                "Tauri: Admin Desktop (Dev)",
                ".NET Core Launch (API, no browser)"
            ],
            "stopAll": true
        }
    ]
}
