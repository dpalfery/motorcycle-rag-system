<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.WebSourcesPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:WebSourcesViewModel"
             Title="Web Sources">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Header with Buttons -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <Label Text="Trusted Web Sources"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

            <Button Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    HorizontalOptions="End" />

            <Button Text="Add Source"
                    Command="{Binding OpenAddSourceFormCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    HorizontalOptions="End" />
        </HorizontalStackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <!-- Error Message -->
                <Frame BorderColor="Red" CornerRadius="8" Padding="15" 
                       BackgroundColor="#FFE5E5"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibleConverter}}">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="12"
                           LineBreakMode="WordWrap" />
                </Frame>

                <!-- Add Source Form (Conditional) -->
                <Frame BorderColor="#4CAF50" CornerRadius="8" Padding="15" 
                       BackgroundColor="#F1F8F5"
                       IsVisible="{Binding ShowAddSourceForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Add New Web Source"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Source Name" FontSize="12" FontAttributes="Bold" />
                            <Entry Text="{Binding NewSourceName}"
                                   Placeholder="e.g., Honda Official"
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="URL" FontSize="12" FontAttributes="Bold" />
                            <Entry Text="{Binding NewSourceUrl}"
                                   Placeholder="https://example.com"
                                   Keyboard="Url"
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Description" FontSize="12" FontAttributes="Bold" />
                            <Editor Text="{Binding NewSourceDescription}"
                                    Placeholder="Brief description of the source"
                                    HeightRequest="60"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Trust Tier" FontSize="12" FontAttributes="Bold" />
                            <Picker SelectedIndex="{Binding SelectedTrustTier}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                                <Picker.Items>
                                    <x:String>Tier C - Community</x:String>
                                    <x:String>Tier B - Reputable Media</x:String>
                                    <x:String>Tier A - OEM</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding NewSourceIsEnabled}"
                                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                            <Label Text="Enabled"
                                   FontSize="12"
                                   Margin="-38,0,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding NewSourceIncludeInSearch}"
                                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                            <Label Text="Include in Search"
                                   FontSize="12"
                                   Margin="-38,0,0,0" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Save"
                                    Command="{Binding AddSourceCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />

                            <Button Text="Cancel"
                                    Command="{Binding CloseAddSourceFormCommand}"
                                    BackgroundColor="LightGray"
                                    TextColor="Black"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Web Sources List -->
                <CollectionView ItemsSource="{Binding WebSources}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                            <Label Text="No web sources configured" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="Add trusted web sources to enable web-based search in the RAG system." 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="LightGray" Margin="0,5" Padding="15" CornerRadius="8">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                    <!-- Source Name and Status -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="14" />

                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Url}"
                                                   FontSize="11"
                                                   TextColor="Blue"
                                                   TextDecorations="Underline"
                                                   LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Delete Button -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="Delete"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSourceCommand}"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="Red"
                                            TextColor="White"
                                            FontSize="11"
                                            Padding="10,5" />

                                    <!-- Description -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"
                                           Margin="0,8,0,0"
                                           IsVisible="{Binding Description, Converter={StaticResource StringToVisibleConverter}}" />

                                    <!-- Trust Tier Badge -->
                                    <Frame Grid.Row="2" Grid.Column="0"
                                           Margin="0,8,0,0"
                                           Padding="8,4"
                                           CornerRadius="12"
                                           BorderColor="{Binding TrustTierColor}"
                                           BackgroundColor="{Binding TrustTierColor}">
                                        <Label Text="{Binding TrustTierLabel}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               Margin="-8,-4,-8,-4" />
                                    </Frame>

                                    <!-- Status and Metadata -->
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1"
                                                         Grid.RowSpan="2"
                                                         Spacing="4"
                                                         Margin="10,8,0,0">
                                        <Label Text="{Binding StatusLabel}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding IsEnabled, Converter={StaticResource EnabledToColorConverter}}" />
                                        <Label Text="{Binding CrawlFrequencyHours, StringFormat='Crawl: {0}h'}"
                                               FontSize="10"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <!-- Metadata Row -->
                                    <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="2" Margin="0,8,0,0">
                                        <Label FontSize="10" TextColor="Gray"
                                               IsVisible="{Binding CreatedDate}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Created: {0:MMM d, yyyy}">
                                                    <Binding Path="CreatedDate" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                        <Label FontSize="10" TextColor="Gray"
                                               IsVisible="{Binding LastCrawledDate, Converter={StaticResource HasValueConverter}}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Last crawled: {0:MMM d, yyyy HH:mm}">
                                                    <Binding Path="LastCrawledDate" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Information Section -->
                <Frame BorderColor="LightGray" CornerRadius="8" Padding="15" BackgroundColor="#F9F9F9">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="About Web Sources"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label Text="Web sources are trusted domains used for supplementary search results. The system will only retrieve information from explicitly approved domains."
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />

                        <Label Text="Trust Tiers:"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,10,0,5" />

                        <Label Text="• Tier A: OEM Manuals (Highest Trust)"
                               FontSize="11"
                               Margin="10,0,0,0" />

                        <Label Text="• Tier B: Reputable Media (Medium Trust)"
                               FontSize="11"
                               Margin="10,0,0,0" />

                        <Label Text="• Tier C: Community Sources (Lower Trust)"
                               FontSize="11"
                               Margin="10,0,0,0" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
