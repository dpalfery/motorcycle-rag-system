<Project>
  <!--
    Extracted-repo-ready defaults for Kyber-Weave.

    When still nested under MotorcycleRAG, MSBuild stops at this file, so we
    explicitly chain the nearest parent Directory.Build.props above this tree.
    When the tree is extracted (no parent props), the Import is skipped and the
    PropertyGroups below supply analyzers / nullable / language defaults so
    Core, Cli, Mcp, and Tests build without MotorcycleRAG.
  -->
  <PropertyGroup>
    <_KyberWeaveParentDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_KyberWeaveParentDirectoryBuildProps>
  </PropertyGroup>

  <Import Project="$(_KyberWeaveParentDirectoryBuildProps)"
          Condition="'$(_KyberWeaveParentDirectoryBuildProps)' != ''" />

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzers>true</RunAnalyzers>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Align with MotorcycleRAG root suppressions so nested + isolated builds stay quiet on the same noise set. -->
    <NoWarn>$(NoWarn);S1451;S1128;S122;S113;S109;S121;S4055;S4056;S4058;CA1822;CA2007;CA1031;CA1860;CA1873;CA1848;CA1852;CA1859;CA1001;CA1063;CA2227;CA4004;S3776;S138;S134;S126;S1541;S3242;S3260;S3353;S2325;S1643;S1449;S1135;CA1805;CA1515;S3059;CA1502;CA1062;CA1506</NoWarn>
  </PropertyGroup>
</Project>
