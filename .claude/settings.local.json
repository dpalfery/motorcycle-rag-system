{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*:*)",
      "Read(**/*)",
      "Glob(**/*)",
      "Grep(**/*)",
      "Edit(**/*)",
      "Write(**/*)",
      "WebSearch",
      "Skill(azure-cli)",
      "Skill(azure-naming)",
      "Skill(browser-testing)",
      "Skill(clean-architecture)",
      "Skill(delegate-dotnet)",
      "Skill(delegate-frontend)",
      "Skill(github-cli)",
      "Skill(mandatory-review)"
    ],
    "deny": [
      "Bash(git push origin *)",
      "Bash(git commit:*)"
    ]
  },
  "slashCommands": {
    "/push": "save all files, stage all files, generate a detailed commit message. commit all changes with message, pull from origin with rebase, fix any merge issues and then push"
  }
}