<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- XHarness (device test runner + CLI) is published to the dotnet-eng feed, not nuget.org. -->
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
  </packageSources>
  <!-- Restrict the prerelease eng feed to just the XHarness packages so it can't shadow
       other dependencies that should come from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="Microsoft.DotNet.XHarness.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
