<Project>
  <PropertyGroup>
    <!-- Enable .NET analyzer support for all projects -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    
    <!-- Use latest analysis level for .NET 10 (includes all rules) -->
    <AnalysisLevel>latest-All</AnalysisLevel>
    
    <!-- Analyze all categories (API design, security, performance, reliability, maintainability) -->
    <AnalysisMode>all</AnalysisMode>
    
    <!-- Treat warnings as errors to enforce quality (Option A: Aggressive) -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Enable nullable reference types analysis -->
    <Nullable>enable</Nullable>
    
    <!-- Enable implicit usings -->
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Code analysis results -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzers>true</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- SonarAnalyzer.CSharp package intentionally removed from build to reduce style/noise
         Sonar rules (Sxxxx) generate a large number of style-only diagnostics. To re-enable,
         re-add the PackageReference below or revert this change. -->
  </ItemGroup>

  <PropertyGroup>
    <!-- Analyzer verbosity for CI/CD -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    
    <!-- Suppress S1451 (file header requirement) -->
    <NoWarn>$(NoWarn);S1451;S1128;S122;S113;S109;S121;S4055;S4056;S4058;CA1822;CA2007;CA1031;CA1860;CA1873;CA1848;CA1852;CA1859;CA1001;CA1063;CA2227;CA4004;S3776;S138;S134;S126;S1541;S3242;S3260;S3353;S2325;S1643;S1449;S1135;CA1805;CA1515;S3059;CA1502;CA1062</NoWarn>
  </PropertyGroup>
</Project>
