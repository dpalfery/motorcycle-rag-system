# EditorConfig is awesome: https://EditorConfig.org
# top-most EditorConfig file
root = true

# CA2227: Change collection properties to read-only (will be addressed in code fixes)
# S4004: Make collection properties read-only (will be addressed in code fixes)
# S3956: Use generic collections (will be addressed in code fixes)

# Default settings for all files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Code files
[*.{cs,csx,vb,vbx}]
indent_style = space
indent_size = 4
 
# Generated code: scope analyzers away from auto-generated sources
[**/*.g.cs]
generated_code = true

[**/*.g.i.cs]
generated_code = true

[**/*.designer.cs]
generated_code = true

[**/*.generated.cs]
generated_code = true

[**/*AssemblyInfo.cs]
generated_code = true

# XML files
[*.{props,targets,ruleset,vsixmanifest,vsct}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# C# code style settings
[*.cs]

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Namespace preferences
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = namespace, type, method, property, indexor, struct, enum, accessor

# Code style rules (IDExxxx)
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Language keywords vs BCL types preferences
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Modifier preferences
dotnet_style_readonly_field = true:suggestion

# Parameter preferences
dotnet_code_quality_unused_parameters = all:suggestion

# Parentheses preferences
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent

# Suppress nullability warnings for legacy code
# Uncomment the following line temporarily when migrating existing code:
# dotnet_style_prefer_is_null_check_over_reference_equality_method = true:silent

# Naming conventions
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.interface_should_be_begins_with_i.style.capitalization = pascal_case

dotnet_style_naming_rule.interface_should_be_begins_with_i.required_prefix = I

