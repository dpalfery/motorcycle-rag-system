<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.JobsPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:JobsViewModel"
             Title="Pipeline Jobs">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <Label Text="Pipeline Jobs"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

            <Button Text="Refresh"
                    Command="{Binding LoadJobsCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    HorizontalOptions="End" />
        </HorizontalStackLayout>

        <Frame Grid.Row="1"
               Margin="0,0,0,15"
               Padding="12"
               BorderColor="#D9A441"
               BackgroundColor="#332813"
               IsVisible="{Binding HasApiPollingProblemMessage}">
            <Label Text="{Binding ApiPollingProblemMessage}"
                   FontSize="12"
                   TextColor="#FFD27A" />
        </Frame>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="18">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Local Processor"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Frame BorderColor="LightGray"
                           Padding="15"
                           CornerRadius="8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Start, stop, and monitor the Python processor that runs on this machine. Local graph jobs keep the raw CSV on this device and only upload the processed graph artifact."
                                   FontSize="12"
                                   TextColor="Gray" />

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="{Binding LocalProcessorStateLabel}"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding LocalProcessorStatusMessage}"
                                           FontSize="11"
                                           TextColor="Gray">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding LocalProcessorStatusIsError}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="#FF6B6B" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Start"
                                        Command="{Binding StartLocalProcessorCommand}"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="White"
                                        IsEnabled="{Binding CanStartLocalProcessor}" />

                                <Button Grid.Column="2"
                                        Text="Stop"
                                        Command="{Binding StopLocalProcessorCommand}"
                                        BackgroundColor="#B05D5D"
                                        TextColor="White"
                                        IsEnabled="{Binding CanStopLocalProcessor}" />

                                <ActivityIndicator Grid.Column="3"
                                                   IsRunning="{Binding IsStartingLocalProcessor}"
                                                   IsVisible="{Binding IsStartingLocalProcessor}"
                                                   VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Opacity="0.2" />

                            <Label Text="Start Local Graph Job"
                                   FontSize="16"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Choose CSV"
                                        Clicked="OnChooseCsvClicked"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        IsEnabled="{Binding CanSelectLocalGraphFile}" />

                                <Button Text="Start Local Graph Job"
                                        Command="{Binding StartLocalGraphJobCommand}"
                                        BackgroundColor="DarkSlateBlue"
                                        TextColor="White"
                                        IsEnabled="{Binding CanStartLocalGraphJob}" />

                                <ActivityIndicator IsRunning="{Binding IsStartingLocalGraphJob}"
                                                   IsVisible="{Binding IsStartingLocalGraphJob}"
                                                   VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding SelectedLocalGraphFilePath}"
                                   FontSize="11"
                                   LineBreakMode="MiddleTruncation"
                                   IsVisible="{Binding HasSelectedLocalGraphFile}" />

                            <Label Text="{Binding LocalGraphStatusMessage}"
                                   FontSize="11"
                                   TextColor="Gray"
                                   IsVisible="{Binding HasLocalGraphStatusMessage}" />

                            <!-- Diagnostic Output -->
                            <BoxView HeightRequest="1" Opacity="0.2"
                                     IsVisible="{Binding ShowLocalProcessorDiagnosticPanel}" />

                            <Label Text="Recent Process Output"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding ShowLocalProcessorDiagnosticPanel}" />

                            <Frame BorderColor="#333333"
                                   BackgroundColor="#1A1A1A"
                                   Padding="10"
                                   CornerRadius="4"
                                   IsVisible="{Binding ShowLocalProcessorDiagnosticPanel}">
                                <ScrollView HeightRequest="180">
                                    <Editor Text="{Binding LocalProcessorDiagnosticOutput}"
                                            Placeholder="No recent process output."
                                            IsReadOnly="True"
                                            FontFamily="Courier New"
                                            FontSize="10"
                                            TextColor="#CCCCCC"
                                            BackgroundColor="Transparent"
                                            AutoSize="TextChanges" />
                                </ScrollView>
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="Local Processor Jobs"
                               FontSize="20"
                               FontAttributes="Bold" />

                        <Button Grid.Column="1"
                                Text="Clear Finished"
                                Command="{Binding ClearLocalProcessorJobsCommand}"
                                BackgroundColor="#5A5A5A"
                                TextColor="White"
                                FontSize="11"
                                Padding="12,6"
                                IsEnabled="{Binding CanClearLocalProcessorJobs}" />

                        <ActivityIndicator Grid.Column="2"
                                           IsRunning="{Binding IsClearingLocalProcessorJobs}"
                                           IsVisible="{Binding IsClearingLocalProcessorJobs}"
                                           VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Local graph processing runs appear here while the processor is working on files from this machine. Use Import To Graph after a local bike-graph run completes."
                           FontSize="12"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding LocalProcessorJobs}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="No local processor jobs found"
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                                <Label Text="Start the local processor and run a local graph job to see status here."
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LocalProcessorJobViewModel">
                                <Frame BorderColor="LightGray"
                                       Margin="0,5"
                                       Padding="15"
                                       CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Row="0"
                                                             Grid.Column="0"
                                                             Spacing="5">
                                            <Label Text="{Binding JobId}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding DocumentTypeLabel}"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="|"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding ProgressLabel}"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0"
                                                             Grid.Column="1"
                                                             Spacing="6">
                                            <Button Text="{Binding ImportButtonText}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ImportLocalProcessorJobCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource Tertiary}"
                                                    TextColor="White"
                                                    FontSize="11"
                                                    Padding="10,5"
                                                    IsEnabled="{Binding CanImportProcessedGraph}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1"
                                                             Grid.ColumnSpan="2"
                                                             Spacing="3"
                                                             Margin="0,10,0,0">
                                            <Label Text="{Binding UploadId, StringFormat='Upload ID: {0}'}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                            <Label Text="{Binding Message}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                            <Label Text="{Binding GraphMetricsLabel}"
                                                   FontSize="11"
                                                   TextColor="Gray"
                                                   IsVisible="{Binding HasGraphMetrics}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding GraphImportStatus, StringFormat='Graph import: {0}'}"
                                               FontSize="11"
                                               TextColor="Gray"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding HasGraphImportStatus}" />

                                        <Label Grid.Row="3"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding GraphImportFailureReason, StringFormat='Last import failure: {0}'}"
                                               FontSize="11"
                                               TextColor="Orange"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding HasGraphImportFailureReason}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Pending Storage Files"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Blob-backed source files appear here while search ingestion or graph import is still outstanding."
                           FontSize="12"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding PendingStorageFiles}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="No pending storage files found"
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                                <Label Text="Files disappear once their remaining search and graph actions are either complete or already running."
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PendingStorageFileViewModel">
                                <Frame BorderColor="LightGray"
                                       Margin="0,5"
                                       Padding="15"
                                       CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label Text="{Binding BlobName}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding DocumentTypeLabel}"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="|"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="{Binding DisplayStatus}"
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <Button Text="{Binding ProcessButtonText}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProcessPendingStorageFileCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White"
                                                    FontSize="11"
                                                    Padding="10,5"
                                                    IsEnabled="{Binding CanStartPrimaryAction}" />

                                            <Button Text="{Binding GraphImportButtonText}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProcessPendingStorageFileAsGraphCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="DarkSlateBlue"
                                                    TextColor="White"
                                                    FontSize="11"
                                                    Padding="10,5"
                                                    IsVisible="{Binding HasGraphWorkflow}"
                                                    IsEnabled="{Binding CanStartGraphImport}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="3" Margin="0,10,0,0">
                                            <Label Text="{Binding UploadId, StringFormat='Upload ID: {0}'}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                            <Label Text="{Binding SizeLabel, StringFormat='Size: {0}'}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                            <Label FontSize="11" TextColor="Gray">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Last modified: {0:g}">
                                                        <Binding Path="LastModifiedUtc" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding FailureReason, StringFormat='Last failure: {0}'}"
                                               FontSize="11"
                                               TextColor="Orange"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding HasFailureReason}" />

                                        <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="3" Margin="0,8,0,0"
                                                             IsVisible="{Binding HasGraphWorkflow}">
                                            <Label Text="{Binding GraphWorkflowStatusText}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                            <Label Text="{Binding GraphImportFailureReason, StringFormat='Last graph failure: {0}'}"
                                                   FontSize="11"
                                                   TextColor="Orange"
                                                   IsVisible="{Binding HasGraphImportFailureReason}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Ingestion Jobs"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Queued and recent ingestion or graph-import runs appear here with their current status."
                           FontSize="12"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding IngestionJobs}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="No ingestion jobs found"
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                                <Label Text="Queue a pending storage file to create an ingestion job."
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:IngestionJobHistoryViewModel">
                                <Frame BorderColor="LightGray"
                                       Margin="0,5"
                                       Padding="15"
                                       CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*">

                                        <VerticalStackLayout Grid.Row="0" Spacing="5">
                                            <Label Text="{Binding JobId}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding InputTypeLabel}"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="|"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Spacing="3" Margin="0,10,0,0">
                                            <Label Text="{Binding InputRef, StringFormat='Input: {0}'}"
                                                   FontSize="11"
                                                   TextColor="Gray" />

                                            <Label FontSize="11" TextColor="Gray">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Created: {0:g}">
                                                        <Binding Path="CreatedAtUtc" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                            <Label FontSize="11" TextColor="Gray"
                                                   IsVisible="{Binding StartedAtUtc, Converter={StaticResource HasValueConverter}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Started: {0:g}">
                                                        <Binding Path="StartedAtUtc" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                            <Label FontSize="11" TextColor="Gray"
                                                   IsVisible="{Binding CompletedAtUtc, Converter={StaticResource HasValueConverter}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Completed: {0:g}">
                                                        <Binding Path="CompletedAtUtc" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Row="2"
                                               Text="{Binding FabricRunId, StringFormat='Fabric run: {0}'}"
                                               FontSize="11"
                                               TextColor="Gray"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding HasFabricRunId}" />

                                        <Label Grid.Row="3"
                                               Text="{Binding FailureReason, StringFormat='Failure: {0}'}"
                                               FontSize="11"
                                               TextColor="Red"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding HasFailureReason}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Pipeline Executions"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="This legacy execution feed remains available for existing pipeline runs."
                           FontSize="12"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding Jobs}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                                <Label Text="No pipeline executions found"
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                                <Label Text="Configure authentication to load jobs from the API"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:JobViewModel">
                                <Frame BorderColor="LightGray"
                                       Margin="0,5"
                                       Padding="15"
                                       CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label Text="{Binding ExecutionId}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding PipelineType}"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="|"
                                                       FontSize="12"
                                                       TextColor="Gray" />
                                                <Label Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Button Grid.Row="0" Grid.Column="1"
                                                Text="Cancel"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelJobCommand}"
                                                CommandParameter="{Binding ExecutionId}"
                                                BackgroundColor="Red"
                                                TextColor="White"
                                                FontSize="11"
                                                Padding="10,5"
                                                IsVisible="{Binding IsRunning}" />

                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="3" Margin="0,10,0,0">
                                            <Label FontSize="11" TextColor="Gray">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Started: {0:g}">
                                                        <Binding Path="StartTime" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                            <Label FontSize="11" TextColor="Gray"
                                                   IsVisible="{Binding EndTime, Converter={StaticResource HasValueConverter}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Ended: {0:g}">
                                                        <Binding Path="EndTime" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding CreatedBy, StringFormat='Created by: {0}'}"
                                               FontSize="10"
                                               TextColor="Gray"
                                               Margin="0,5,0,0"
                                               IsVisible="{Binding HasCreatedBy}" />

                                        <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0"
                                                             IsVisible="{Binding HasErrors}">
                                            <Label Text="Errors:"
                                                   FontSize="11"
                                                   TextColor="Red"
                                                   FontAttributes="Bold" />

                                            <CollectionView ItemsSource="{Binding Errors}"
                                                            SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Text="{Binding .}"
                                                               FontSize="10"
                                                               TextColor="Red"
                                                               Margin="10,0,0,2" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="5" Margin="0,5,0,0"
                                                             IsVisible="{Binding HasWarnings}">
                                            <Label Text="Warnings:"
                                                   FontSize="11"
                                                   TextColor="Orange"
                                                   FontAttributes="Bold" />

                                            <CollectionView ItemsSource="{Binding Warnings}"
                                                            SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Text="{Binding .}"
                                                               FontSize="10"
                                                               TextColor="Orange"
                                                               Margin="10,0,0,2" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
