<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorcycleRAG.Admin.Pages.DashboardPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Welcome Section -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Welcome to Motorcycle RAG Admin"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Manage data ingestion, monitor pipeline jobs, and configure trusted sources."
                           FontSize="12"
                           TextColor="Gray"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Actions -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Quick Actions" FontSize="18" FontAttributes="Bold" />

                    <Button Text="Upload New File"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            Command="{Binding NavigateToUploadCommand}" />

                    <Button Text="View Pipeline Jobs"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            Command="{Binding NavigateToJobsCommand}" />

                    <Button Text="Manage Web Sources"
                            BackgroundColor="{StaticResource Tertiary}"
                            TextColor="White"
                            Command="{Binding NavigateToWebSourcesCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Statistics Section (Placeholder) -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="System Statistics" FontSize="18" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Spacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="10" BackgroundColor="#F0F0F0" CornerRadius="4">
                            <Label Text="Documents Indexed" FontSize="12" TextColor="Gray" />
                            <Label Text="0" FontSize="24" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="10" BackgroundColor="#F0F0F0" CornerRadius="4">
                            <Label Text="Chunks Created" FontSize="12" TextColor="Gray" />
                            <Label Text="0" FontSize="24" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Padding="10" BackgroundColor="#F0F0F0" CornerRadius="4">
                            <Label Text="Recent Jobs" FontSize="12" TextColor="Gray" />
                            <Label Text="0" FontSize="24" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="10" BackgroundColor="#F0F0F0" CornerRadius="4">
                            <Label Text="Web Sources" FontSize="12" TextColor="Gray" />
                            <Label Text="0" FontSize="24" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Recent Activity -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recent Activity" FontSize="18" FontAttributes="Bold" />
                    <Label Text="No recent activity" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
