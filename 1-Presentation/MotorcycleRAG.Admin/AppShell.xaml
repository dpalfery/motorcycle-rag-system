<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorcycleRAG.Admin.AppShell"
    x:ClassModifier="Internal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Pages="clr-namespace:MotorcycleRAG.Admin.Pages"
    Title="Motorcycle RAG Admin"
    FlyoutBehavior="Locked"
    FlyoutIsPresented="False">

    <!-- Define Shell TitleView for top header with user profile and sign out -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto"
              Padding="15,0"
              VerticalOptions="Center"
              HeightRequest="56">

            <!-- Title -->
            <Label Text="Motorcycle RAG Admin"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="White"/>

            <!-- User Profile Section (Sign Out Button) -->
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="10"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End">

                <Label x:Name="UserDisplayName"
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="Gray"/>

                <Button x:Name="AuthButton"
                        Text="Sign Out"
                        Clicked="OnAuthButtonClicked"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        Padding="15,8"
                        FontSize="12"
                        CornerRadius="4"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <!-- Flyout customizations (Shell doesn't support <Shell.Flyout>) -->
    <Shell.FlyoutHeader>
        <Grid Padding="20,20"
              BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout Spacing="5">
                <Label Text="Motorcycle RAG"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="Admin Portal"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.8"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <StackLayout Padding="20"
                     BackgroundColor="{StaticResource Primary}">
            <Label Text="v1.0.0"
                   FontSize="10"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Opacity="0.6"/>
        </StackLayout>
    </Shell.FlyoutFooter>

    <!-- Navigation Structure -->
    <FlyoutItem Title="Dashboard"
                Icon="home.png"
                Route="dashboard">
        <ShellContent Title="Dashboard"
                      Route="dashboardpage"
                      ContentTemplate="{DataTemplate Pages:DashboardPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Upload"
                Icon="upload.png"
                Route="upload">
        <ShellContent Title="Upload and Process"
                      Route="uploadpage"
                      ContentTemplate="{DataTemplate Pages:UploadPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Pipeline Jobs"
                Icon="tasks.png"
                Route="jobs">
        <ShellContent Title="Pipeline Jobs"
                      Route="jobspage"
                      ContentTemplate="{DataTemplate Pages:JobsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Web Sources"
                Icon="globe.png"
                Route="websources">
        <ShellContent Title="Web Sources"
                      Route="websourcespage"
                      ContentTemplate="{DataTemplate Pages:WebSourcesPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Tools"
                Icon="tools.png"
                Route="tools">
        <ShellContent Title="Tools and Settings"
                      Route="toolspage"
                      ContentTemplate="{DataTemplate Pages:ToolsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings"
                Icon="settings.png"
                Route="settings">
        <ShellContent Title="Settings"
                      Route="settingspage"
                      ContentTemplate="{DataTemplate Pages:SettingsPage}"/>
    </FlyoutItem>

    <!-- TabBar can be used for modal or secondary navigation if needed -->
    <TabBar x:Name="MainTabBar"/>

</Shell>
