{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.ApplicationInsights": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "AllowedHosts": "localhost,127.0.0.1,::1",
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"]
  },
  "AzureAd": {
    "Instance": "https://palfery.ciamlogin.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID"
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "EnableTelemetry": true,
    "ApplicationName": "MotorcycleRag.WebUI.BFF"
  },
  "DataProtection": {
    "BlobUri": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "HttpClient": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7215"
          }
        }
      }
    }
  }
}