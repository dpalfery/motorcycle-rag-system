{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7215",
    "TimeoutSeconds": 30
  },
  "Authentication": {
    "ClientId": "YOUR_AZURE_AD_CLIENT_ID",
    "TenantId": "YOUR_AZURE_AD_TENANT_ID",
    "RedirectUri": "msauth.com.motorcyclerag.mobile://auth",
    "Scopes": [
      "api://motorcyclerag-api/read",
      "api://motorcyclerag-api/chat"
    ]
  }
}
