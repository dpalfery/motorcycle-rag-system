# ──────────────────────────────────────────────────
# MotorcycleRAG Local Processing Service — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────

# ── Embedding backend selector ───────────────────
# Choose which embedder to use for ingestion-time embeddings.
# Valid values: ollama | openai
EMBEDDING_BACKEND=ollama

# Optional generic provider endpoint. When set, the service probes this URL first
# as OpenAI-compatible (LM Studio, Foundry Local, etc.), then as Ollama, and uses the selected model below.
EMBEDDING_PROVIDER_ENDPOINT=
EMBEDDING_MODEL=

# ── Ollama (local embedding server) ──────────────
# Base URL of the local Ollama server (OpenAI-compatible).
# Read by OllamaEmbedder via the OLLAMA_BASE_URL env var (default: http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model tag used for embeddings (read by OllamaEmbedder via OLLAMA_MODEL).
OLLAMA_MODEL=qwen3-embedding

# ── OpenAI-compatible embedder ───────────────────
# Any OpenAI-compatible embedding server (LM Studio, Ollama /v1, Foundry Local, etc.).
# Default endpoint used when EMBEDDING_BACKEND=openai and no EMBEDDING_PROVIDER_ENDPOINT is set.
# EMBEDDING_PROVIDER_ENDPOINT=http://localhost:1234/v1
# EMBEDDING_MODEL=qwen3-embedding
# (Optional) API key for cloud providers. Leave unset for local servers.
# EMBEDDING_PROVIDER_API_KEY=

# ── Azure AI Search (direct upload) ─────────────
# Your Azure AI Search service endpoint.
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
# Target index name (must already exist with 1536-dim vector field).
# LM Studio does NOT support server-side dimension truncation; client-side MRL slicing is applied.
AZURE_SEARCH_INDEX=motorcycle-index
# (Optional) Azure AI Search API key. Leave blank to use DefaultAzureCredential.
AZURE_SEARCH_KEY=

# ── Logging ──────────────────────────────────────
# Directory where rolling log files are written.
# Defaults to ./logs (relative to the working directory when the service starts).
LOCAL_PROCESSOR_LOG_DIR=./logs

# ── Chunking configuration ───────────────────────
# Maximum number of tokens used when chunking PDF documents.
PDF_CHUNKER_MAX_TOKENS=512
# Optional tokenizer model path. Defaults to matching EMBEDDING_MODEL under
# LM_STUDIO_MODELS_DIR, then to Hugging Face model id resolution for names like
# Qwen/Qwen3-Embedding-4B.
TOKENIZER_MODEL_PATH=
# Local LM Studio model cache searched when TOKENIZER_MODEL_PATH is empty.
LM_STUDIO_MODELS_DIR=~/.lmstudio/models
# Legacy explicit tokenizer identifier override. Leave empty to use EMBEDDING_MODEL.
PDF_CHUNKER_TOKENIZER=
# Maximum number of tokens used when chunking CSV documents.
MAX_CHUNK_SIZE_TOKENS=512

# ── Azure Blob Storage (PDF / CSV staging) ───────
# Connection string for the storage account used for raw file staging.
AZURE_STORAGE_CONNECTION_STRING=<your-connection-string>
# Container name for staged uploads.
AZURE_STORAGE_CONTAINER=motorcycle-docs

# ── Graph extraction (OpenAI-compatible LLM) ─────
# Required. Local LM Studio OpenAI-compatible endpoint.
GRAPH_EXTRACTION_ENDPOINT=http://localhost:1234/v1
# Required. Must match the model configured in Admin Desktop Settings
# (graphExtractionModel). No code fallback — set this explicitly.
GRAPH_EXTRACTION_MODEL=microsoft/phi-4-reasoning-plus

# ── MotorcycleRAG API (M2M upload) ──────────────
# Base URL of the MotorcycleRAG API.
# The local API dev profile listens on https://localhost:7215.
MCR_API_BASE_URL=https://localhost:7215
# Entra client ID for the Python-Upload-Job app registration.
MCR_LOCAL_PROCESSOR_CLIENT_ID=d09d356d-62ac-4f38-b636-64169119ea25
# Client secret for the Python-Upload-Job app registration (NEVER commit this).
PYTHON_UPLOAD_JOB_SECRET=<your-client-secret>
# Entra tenant ID.
MCR_LOCAL_PROCESSOR_TENANT_ID=0f8f8a52-f135-43af-af88-e0b54ca9ff91
# API scope for M2M — always /.default for client credentials.
MCR_API_SCOPE=api://motorcyclerag-api/.default
