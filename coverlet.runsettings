<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
    <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
            <Format>cobertura</Format>
            <ExcludeByFile>**/Migrations/**,**/*.Designer.cs,**/*.generated.cs,**/*.g.cs,**/MotorcycleRag.WebUI.BFF/**/Program.cs,**/SqlConnectionFactory.cs,**/SearchClientFactory.cs,**/Telemetry/TelemetryService.cs,**/Azure/AzureFoundryClientWrapper.cs,**/Azure/FoundryClientFactory.cs,**/HealthChecks/SqlDatabaseHealthCheck.cs</ExcludeByFile>
            <ExcludeByAttribute>Obsolete,GeneratedCode</ExcludeByAttribute>
            <Exclude>[MotorcycleRAG.Contracts.Models]*,[MotorcycleRAG.DbSetup]*,[MotorcycleRAG.*.Test*]*,[xunit.*]*</Exclude>
        </Configuration>
    </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
