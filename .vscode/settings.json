    "chat.useClaudeMdFile": false,
    "github.copilot.chat.claudeAgent.enabled": false,
    "github.copilot.chat.claude47OpusPrompt.enabled": false,
    "chat.agentHost.claudeAgent.enabled": false,
    "chat.agentFilesLocations": {
