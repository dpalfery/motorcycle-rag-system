{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    },
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@3.0.0-beta.21",
        "server",
        "start",
        "--read-only"
      ],
      "environment": {
        "AZURE_MCP_COLLECT_TELEMETRY": "false",
        "AZURE_MCP_COLLECT_TELEMETRY_MICROSOFT": "false"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "{{DEFAULT_MINIMUM_TOKENS}}"
      }
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}