# ──────────────────────────────────────────────────
# MotorcycleRAG Local Processing Service — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────

# ── Embedding backend selector ───────────────────
# Choose which embedder to use for ingestion-time embeddings.
# Valid values: ollama | foundry_local | deepinfra
EMBEDDING_BACKEND=ollama

# Optional generic provider endpoint. When set, the service probes this URL first
# as OpenAI-compatible, then as Ollama, and uses the selected model below.
EMBEDDING_PROVIDER_ENDPOINT=
EMBEDDING_MODEL=

# ── Ollama (local GPU, default) ──────────────────
# Base URL of your running Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model name to use for embeddings.
OLLAMA_MODEL=qwen3-embedding

# ── Azure AI Foundry Local ───────────────────────
# Base URL of the Azure AI Foundry Local OpenAI-compatible server.
AZURE_FOUNDRY_LOCAL_ENDPOINT=http://localhost:5272
# Model name loaded in Azure AI Foundry Local.
AZURE_FOUNDRY_LOCAL_EMBEDDING_MODEL=qwen3-embedding

# ── DeepInfra (remote, query-time embeddings) ────
# Your DeepInfra API key (https://deepinfra.com).
DEEPINFRA_API_KEY=<your-deepinfra-api-key>
# DeepInfra OpenAI-compatible base URL (do not change unless using a proxy).
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DeepInfra embedding model name.
DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# ── Azure AI Search (direct upload) ─────────────
# Your Azure AI Search service endpoint.
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
# Target index name (must already exist with 3584-dim vector field).
AZURE_SEARCH_INDEX=motorcycle-index
# (Optional) Azure AI Search API key. Leave blank to use DefaultAzureCredential.
AZURE_SEARCH_KEY=

# ── Logging ──────────────────────────────────────
# Directory where rolling log files are written.
# Defaults to ./logs (relative to the working directory when the service starts).
LOCAL_PROCESSOR_LOG_DIR=./logs

# ── Azure Blob Storage (PDF / CSV staging) ───────
# Connection string for the storage account used for raw file staging.
AZURE_STORAGE_CONNECTION_STRING=<your-connection-string>
# Container name for staged uploads.
AZURE_STORAGE_CONTAINER=motorcycle-docs

# ── MotorcycleRAG API (M2M upload) ──────────────
# Base URL of the MotorcycleRAG API.
# The local API dev profile listens on https://localhost:7215.
MCR_API_BASE_URL=https://localhost:7215
# Entra client ID for the Python-Upload-Job app registration.
MCR_LOCAL_PROCESSOR_CLIENT_ID=d09d356d-62ac-4f38-b636-64169119ea25
# Client secret for the Python-Upload-Job app registration (NEVER commit this).
PYTHON_UPLOAD_JOB_SECRET=<your-client-secret>
# Entra tenant ID.
MCR_LOCAL_PROCESSOR_TENANT_ID=0f8f8a52-f135-43af-af88-e0b54ca9ff91
# API scope for M2M — always /.default for client credentials.
MCR_API_SCOPE=api://motorcyclerag-api/.default
