<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorcycleRAG.Admin.AppShell"
    x:ClassModifier="Internal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:windows="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.WindowsSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Motorcycle RAG Admin"
    FlyoutBehavior="Locked"
    FlyoutIsPresented="False"
    windows:Page.ToolbarDynamicOverflowEnabled="False">

    <!-- Define Shell TitleView for top header with user profile and sign out -->
    <Shell.TitleView>
        <Grid x:Name="HeaderGrid"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,0,12,0"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="Center"
              HeightRequest="56">

            <!-- Title -->
            <Label Text="Motorcycle RAG Admin"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="White"/>

            <!-- User Profile Section (Sign Out Button) -->
            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="12"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   Margin="24,0,0,0">

                <Label x:Name="UserDisplayName"
                       FontSize="13"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       TextColor="{StaticResource Gray200}"/>

                <Button x:Name="AuthButton"
                        Text="Sign Out"
                        Clicked="OnAuthButtonClicked"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        Padding="16,8"
                        FontSize="12"
                        CornerRadius="4"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <!-- Flyout customizations (Shell doesn't support <Shell.Flyout>) -->
    <Shell.FlyoutHeader>
        <Grid Padding="20,20"
              BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout Spacing="5">
                <Label Text="Motorcycle RAG"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="Admin Portal"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.8"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <StackLayout Padding="20"
                     BackgroundColor="{StaticResource Primary}">
            <Label Text="v1.0.0"
                   FontSize="10"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Opacity="0.6"/>
        </StackLayout>
    </Shell.FlyoutFooter>

    <!-- Navigation Structure -->
    <!-- Content is assigned in AppShell.xaml.cs constructor via DI.
         ContentTemplate=DataTemplate cannot use DI-injected constructors (uses Activator.CreateInstance).
         Setting ShellContent.Content directly is the correct pattern for constructor-injected pages. -->
    <FlyoutItem Title="Dashboard"
                Icon="home.png"
                Route="dashboard">
        <ShellContent x:Name="DashboardContent"
                      Title="Dashboard"
                      Route="dashboardpage"/>
    </FlyoutItem>

    <FlyoutItem Title="Upload"
                Icon="upload.png"
                Route="upload">
        <ShellContent x:Name="UploadContent"
                      Title="Upload and Process"
                      Route="uploadpage"/>
    </FlyoutItem>

    <FlyoutItem Title="Pipeline Jobs"
                Icon="tasks.png"
                Route="jobs">
        <ShellContent x:Name="JobsContent"
                      Title="Pipeline Jobs"
                      Route="jobspage"/>
    </FlyoutItem>

    <FlyoutItem Title="User Management"
                Icon="tasks.png"
                Route="usermanagement">
        <ShellContent x:Name="UserManagementContent"
                      Title="User Management"
                      Route="usermanagementpage"/>
    </FlyoutItem>

    <FlyoutItem Title="Web Sources"
                Icon="globe.png"
                Route="websources">
        <ShellContent x:Name="WebSourcesContent"
                      Title="Web Sources"
                      Route="websourcespage"/>
    </FlyoutItem>

    <FlyoutItem Title="Tools"
                Icon="tools.png"
                Route="tools">
        <ShellContent x:Name="ToolsContent"
                      Title="Tools and Settings"
                      Route="toolspage"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings"
                Icon="settings.png"
                Route="settings">
        <ShellContent x:Name="SettingsContent"
                      Title="Settings"
                      Route="settingspage"/>
    </FlyoutItem>


</Shell>
