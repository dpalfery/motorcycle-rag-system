<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.UserManagementPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:UserManagementViewModel"
             Title="User Management">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              Margin="0,0,0,15">
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="4">
                <Label Text="User Management"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <Label Text="Review pending requests and manage approved users from one table."
                       FontSize="12"
                       TextColor="Gray"/>
                <Label Text="{Binding SummaryText}"
                       FontSize="11"
                       TextColor="Gray"/>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start">
                <Button Text="Search"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </HorizontalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             Margin="0,0,0,15">
            <Entry Text="{Binding SearchText}"
                   Placeholder="Search by email"
                   ClearButtonVisibility="WhileEditing"
                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

            <Frame BorderColor="#D85B5B"
                   BackgroundColor="#FFF0F0"
                   Padding="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibleConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#A40000"
                       FontSize="12"/>
            </Frame>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Rows}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="20">
                        <Label Text="No requests or users found"
                               FontSize="16"
                               HorizontalOptions="Center"/>
                        <Label Text="Refresh the list or broaden the search criteria."
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:UserManagementRowViewModel">
                        <Frame BorderColor="#D0D7DE"
                               Padding="15"
                               Margin="0,0,0,12"
                               CornerRadius="8">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="4">
                                        <Label Text="{Binding Email}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding RowTypeLabel}"
                                               FontSize="11"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <Frame Grid.Column="1"
                                           Padding="10,4"
                                           BackgroundColor="{StaticResource Tertiary}"
                                           CornerRadius="12"
                                           HasShadow="False">
                                        <Label Text="{Binding StatusText}"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </Grid>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="4">
                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding ProviderLabel, StringFormat='Provider: {0}'}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TierLabelText, StringFormat='Tier: {0}'}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding TimelineText}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                </Grid>

                                <Frame BorderColor="#F0C36D"
                                       BackgroundColor="#FFF8E5"
                                       Padding="10"
                                       HasShadow="False"
                                       IsVisible="{Binding HasFailure}">
                                    <Label Text="{Binding FailureText}"
                                           FontSize="12"
                                           TextColor="#835600"/>
                                </Frame>

                                <Picker Title="Choose tier"
                                        ItemsSource="{Binding AvailableTiers}"
                                        SelectedItem="{Binding SelectedTier}"
                                        IsVisible="{Binding ShowTierPicker}"
                                        IsEnabled="{Binding IsActionEnabled}"/>

                                <Editor Text="{Binding ActionReason}"
                                        Placeholder="{Binding ReasonPlaceholder}"
                                        AutoSize="TextChanges"
                                        HeightRequest="72"
                                        IsVisible="{Binding ShowReasonEditor}"
                                        IsEnabled="{Binding IsActionEnabled}"/>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="Approve"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApproveCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            IsVisible="{Binding CanApprove}"
                                            IsEnabled="{Binding IsActionEnabled}"/>

                                    <Button Grid.Column="1"
                                            Text="Retry"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RetryOnboardingCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="White"
                                            IsVisible="{Binding CanRetry}"
                                            IsEnabled="{Binding IsActionEnabled}"/>

                                    <Button Grid.Column="2"
                                            Text="Change Tier"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChangeTierCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Tertiary}"
                                            TextColor="White"
                                            IsVisible="{Binding CanChangeTier}"
                                            IsEnabled="{Binding IsActionEnabled}"/>

                                    <Button Grid.Column="3"
                                            Text="Cancel"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#B05555"
                                            TextColor="White"
                                            IsVisible="{Binding CanCancel}"
                                            IsEnabled="{Binding IsActionEnabled}"/>

                                    <ActivityIndicator Grid.Column="4"
                                                       IsRunning="{Binding IsBusy}"
                                                       IsVisible="{Binding IsBusy}"
                                                       VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{StaticResource Primary}"/>
        </Grid>
    </Grid>
</ContentPage>