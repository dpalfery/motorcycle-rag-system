<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.UploadPage"
             x:DataType="viewmodels:IngestionViewModel"
             Title="Upload and Process">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- File Selection Section -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Select File" FontSize="18" FontAttributes="Bold" />
                    
                    <Button Text="Choose File" 
                            Command="{Binding SelectFileCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" />
                    
                    <Label Text="{Binding SelectedFilePath}" 
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           IsVisible="{Binding SelectedFilePath, Converter={StaticResource StringNotEmptyConverter}}" />
                    
                    <Label Text="Supported formats: PDF, CSV" 
                           FontSize="11" 
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Processing Options -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Processing Options" FontSize="18" FontAttributes="Bold" />
                    
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding EnableLocalProcessing}" />
                        <Label Text="Enable local processing (chunking + embeddings)" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                    <Label Text="Note: Local processing requires ONNX model in Resources/Raw/" 
                           FontSize="10" 
                           TextColor="Orange"
                           IsVisible="{Binding EnableLocalProcessing}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Process Button -->
            <Button Text="Process File" 
                    Command="{Binding ProcessFileCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Progress Section -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15"
                   IsVisible="{Binding IsProcessing}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Processing..." FontSize="16" FontAttributes="Bold" />
                    
                    <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}"
                                 ProgressColor="{StaticResource Primary}" />
                    
                    <Label Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}" 
                           HorizontalOptions="End" />
                    
                    <Label Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Processed Files List -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Processed Files" FontSize="18" FontAttributes="Bold" />
                    
                    <CollectionView ItemsSource="{Binding ProcessedFiles}"
                                    EmptyView="No files processed yet">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="LightGray" Margin="0,5" Padding="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding FileName}" 
                                               FontAttributes="Bold" />
                                        
                                        <Label FontSize="11">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Status: {0} | Chunks: {1} | Embeddings: {2}">
                                                    <Binding Path="Status" />
                                                    <Binding Path="ChunkCount" />
                                                    <Binding Path="EmbeddingCount" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        
                                        <Label Text="{Binding Metadata}" 
                                               FontSize="10" 
                                               TextColor="Gray" />
                                        
                                        <Label FontSize="10" TextColor="Gray">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Started: {0:g}">
                                                    <Binding Path="StartTime" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
