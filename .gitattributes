# enforce consistent line endings
# text=auto will normalize to LF in repo and convert to CRLF on Windows checkout
* text=auto

# explicitly handle common file types
*.cs     text
*.csproj text
*.json   text
*.xml    text
*.md     text
*.yml    text
*.yaml   text

# binary files (do not alter)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.exe    binary
