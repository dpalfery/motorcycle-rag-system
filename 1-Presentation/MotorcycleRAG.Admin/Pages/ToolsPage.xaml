<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorcycleRAG.Admin.Pages.ToolsPage"
             x:DataType="local:ToolsViewModel"
             xmlns:local="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             Title="MCP Tools Configuration">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Header with Refresh Button -->
        <Grid ColumnDefinitions="*,Auto" Padding="20,15" ColumnSpacing="10">
            <Label Grid.Column="0"
                   Text="Model Context Protocol (MCP) Tools"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Padding="15,10" />
        </Grid>

        <!-- Tools List -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsLoading}"
                     Padding="20,0">
            <CollectionView ItemsSource="{Binding Tools}"
                           SelectionMode="Single"
                           SelectionChangedCommand="{Binding SelectToolCommand}"
                           SelectionChangedCommandParameter="{Binding SelectionChangedItem, Source={RelativeSource Self}}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray"
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,0,0,10"
                               HasShadow="False">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <!-- Tool Details -->
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                        <Label Text="{StringFormat='Type: {0}', Binding ToolType}"
                                               FontSize="11"
                                               TextColor="DarkGray" />
                                        <Label Text="{StringFormat='v{0}', Binding Version}"
                                               FontSize="11"
                                               TextColor="DarkGray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Enable/Disable Toggle -->
                                <VerticalStackLayout Grid.Column="1"
                                                    VerticalOptions="Center"
                                                    Spacing="8">
                                    <Label Text="{Binding IsEnabled, StringFormat='{0:Status}'}"
                                           FontSize="11"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold">
                                        <Label.TextColor>
                                            <MultiBinding Converter="{StaticResource StatusColorConverter}">
                                                <Binding Path="IsEnabled" />
                                            </MultiBinding>
                                        </Label.TextColor>
                                    </Label>

                                    <Switch IsToggled="{Binding IsEnabled}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:ToolsPage}},
                                                             Path=BindingContext.SaveToolCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Empty State -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20"
                                       Spacing="10"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="No MCP tools configured"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Configure tools via the API or import from settings"
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Footer Info -->
        <Frame Grid.Row="2" BorderColor="LightGray" CornerRadius="8" Padding="15" Margin="20,10">
            <VerticalStackLayout Spacing="5">
                <Label Text="MCP Configuration"
                       FontSize="12"
                       FontAttributes="Bold" />
                <Label Text="Enable or disable tools to control which MCP tools are available to the orchestrator."
                       FontSize="11"
                       TextColor="Gray" />
                <Label Text="Changes are audited and synchronized with the backend API."
                       FontSize="11"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
