{
    "mcpServers": {
        "chrome-devtools": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "disabled": false
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ],
            "disabled": false
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "disabled": false
        },
        "snyk": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "snyk@latest",
                "mcp",
                "-t",
                "stdio"
            ],
            "note": "Requires npx (Node.js) to be installed. Disabled by default to reduce context bloat. Use snyk-security skill to enable on-demand.",
            "disabled": true
        }
    }
}