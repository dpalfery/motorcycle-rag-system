<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorcycleRAG.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MotorcycleRAG.MobileApp"
    xmlns:views="clr-namespace:MotorcycleRAG.MobileApp.Views"
    Title="MotorcycleRAG.MobileApp">

    <ShellContent
        Route="AuthenticationPage"
        ContentTemplate="{DataTemplate views:AuthenticationPage}"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Conversations"
        ContentTemplate="{DataTemplate views:ConversationListPage}"
        Route="ConversationListPage" />

</Shell>
