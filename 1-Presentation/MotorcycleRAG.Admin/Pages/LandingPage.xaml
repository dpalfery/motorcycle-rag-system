<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.LandingPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:LandingViewModel"
             Title="Motorcycle RAG Admin">

    <Grid Padding="32"
          RowDefinitions="*,Auto,*"
          BackgroundColor="{StaticResource OffBlack}">

        <Border Grid.Row="1"
                Stroke="{StaticResource Gray600}"
                BackgroundColor="{StaticResource Primary}"
                StrokeShape="RoundRectangle 20"
                Padding="28"
                MaximumWidthRequest="560"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="18">
                <Label Text="Motorcycle RAG Admin"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label Text="Start with sign-in, then manage uploads, pipeline jobs, and the local processor from one place."
                       FontSize="14"
                       TextColor="{StaticResource Gray100}" />

                <Frame BorderColor="{StaticResource Gray600}"
                       BackgroundColor="{StaticResource OffBlack}"
                       CornerRadius="14"
                       Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ConfigurationSummary}"
                               FontSize="12"
                               TextColor="{StaticResource Gray100}" />
                        <Label Text="{Binding SessionSummary}"
                               FontSize="12"
                               TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding StatusMessage}"
                               FontSize="12"
                               TextColor="{StaticResource Tertiary}" />
                    </VerticalStackLayout>
                </Frame>

                <HorizontalStackLayout Spacing="12">
                    <Button Text="{Binding PrimaryActionText}"
                            Command="{Binding SignInCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            HorizontalOptions="Start" />

                    <Button Text="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            HorizontalOptions="Start" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
