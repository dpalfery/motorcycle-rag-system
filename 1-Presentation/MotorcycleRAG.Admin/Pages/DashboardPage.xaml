<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.DashboardPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Dashboard">

        <ContentPage.Resources>
                <Style x:Key="QuickActionButtonStyle" TargetType="Button">
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="HeightRequest" Value="60" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontAttributes" Value="Bold" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VisualStateManager.VisualStateGroups">
                                <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                                <Setter Property="Opacity" Value="1.0" />
                                                                <Setter Property="Scale" Value="1.0" />
                                                        </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                                <Setter Property="Opacity" Value="0.8" />
                                                                <Setter Property="Scale" Value="1.01" />
                                                        </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                                <Setter Property="Opacity" Value="0.6" />
                                                                <Setter Property="Scale" Value="0.98" />
                                                        </VisualState.Setters>
                                                </VisualState>
                                        </VisualStateGroup>
                                </VisualStateGroupList>
                        </Setter>
                </Style>
        </ContentPage.Resources>

        <ScrollView>
                <VerticalStackLayout Padding="20"
                                     Spacing="15">

                        <!-- Configuration Warning Banner -->
                        <Frame BorderColor="#FF6B6B"
                               BackgroundColor="#FFF0F0"
                               CornerRadius="8"
                               Padding="15"
                               IsVisible="{Binding IsNotConfigured}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="5">
                                                <Label Text="Configuration Required"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#B22222"/>
                                                <Label Text="{Binding ConfigurationStatusMessage}"
                                                       FontSize="12"
                                                       TextColor="#8B0000"
                                                       LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Configure Now"
                                                Command="{Binding NavigateToSettingsCommand}"
                                                BackgroundColor="#FF6B6B"
                                                TextColor="White"
                                                Padding="15,8"
                                                FontSize="12"
                                                CornerRadius="4"
                                                VerticalOptions="Center"/>
                                </Grid>
                        </Frame>

                        <!-- Welcome Section -->
                        <Frame BorderColor="LightGray"
                               CornerRadius="8"
                               Padding="15">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Welcome to Motorcycle RAG Admin"
                                               FontSize="20"
                                               FontAttributes="Bold"/>
                                        <Label Text="Manage data ingestion, monitor pipeline jobs, and configure trusted sources."
                                               FontSize="12"
                                               TextColor="Gray"
                                               LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                        </Frame>

                        <!-- Quick Actions -->
                        <Frame BorderColor="LightGray"
                               CornerRadius="8"
                               Padding="15">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Quick Actions"
                                               FontSize="18"
                                               FontAttributes="Bold"/>

                                        <Button Text="Upload New File"
                                                BackgroundColor="{StaticResource Primary}"
                                                Style="{StaticResource QuickActionButtonStyle}"
                                                Command="{Binding NavigateToUploadCommand}"/>

                                        <Button Text="View Pipeline Jobs"
                                                BackgroundColor="{StaticResource Secondary}"
                                                Style="{StaticResource QuickActionButtonStyle}"
                                                Command="{Binding NavigateToJobsCommand}"/>

                                        <Button Text="Manage Web Sources"
                                                BackgroundColor="{StaticResource Tertiary}"
                                                Style="{StaticResource QuickActionButtonStyle}"
                                                Command="{Binding NavigateToWebSourcesCommand}"/>

                                        <Button Text="Configure Tools"
                                                BackgroundColor="{StaticResource Primary}"
                                                Style="{StaticResource QuickActionButtonStyle}"
                                                Command="{Binding NavigateToToolsCommand}"/>
                                </VerticalStackLayout>
                        </Frame>

                        <!-- Statistics Section (Placeholder) -->
                        <Frame BorderColor="LightGray"
                               CornerRadius="8"
                               Padding="15">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="System Statistics"
                                               FontSize="18"
                                               FontAttributes="Bold"/>

                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto"
                                              RowSpacing="10"
                                              ColumnSpacing="10">
                                                <Frame Grid.Row="0"
                                                       Grid.Column="0"
                                                       Padding="10"
                                                       BackgroundColor="#F0F0F0"
                                                       CornerRadius="4"
                                                       HasShadow="False">
                                                        <VerticalStackLayout>
                                                                <Label Text="Documents Indexed"
                                                                       FontSize="12"
                                                                       TextColor="Gray"/>
                                                                <Label Text="0"
                                                                       FontSize="24"
                                                                       FontAttributes="Bold"/>
                                                        </VerticalStackLayout>
                                                </Frame>

                                                <Frame Grid.Row="0"
                                                       Grid.Column="1"
                                                       Padding="10"
                                                       BackgroundColor="#F0F0F0"
                                                       CornerRadius="4"
                                                       HasShadow="False">
                                                        <VerticalStackLayout>
                                                                <Label Text="Chunks Created"
                                                                       FontSize="12"
                                                                       TextColor="Gray"/>
                                                                <Label Text="0"
                                                                       FontSize="24"
                                                                       FontAttributes="Bold"/>
                                                        </VerticalStackLayout>
                                                </Frame>

                                                <Frame Grid.Row="1"
                                                       Grid.Column="0"
                                                       Padding="10"
                                                       BackgroundColor="#F0F0F0"
                                                       CornerRadius="4"
                                                       HasShadow="False">
                                                        <VerticalStackLayout>
                                                                <Label Text="Recent Jobs"
                                                                       FontSize="12"
                                                                       TextColor="Gray"/>
                                                                <Label Text="0"
                                                                       FontSize="24"
                                                                       FontAttributes="Bold"/>
                                                        </VerticalStackLayout>
                                                </Frame>

                                                <Frame Grid.Row="1"
                                                       Grid.Column="1"
                                                       Padding="10"
                                                       BackgroundColor="#F0F0F0"
                                                       CornerRadius="4"
                                                       HasShadow="False">
                                                        <VerticalStackLayout>
                                                                <Label Text="Web Sources"
                                                                       FontSize="12"
                                                                       TextColor="Gray"/>
                                                                <Label Text="0"
                                                                       FontSize="24"
                                                                       FontAttributes="Bold"/>
                                                        </VerticalStackLayout>
                                                </Frame>
                                        </Grid>
                                </VerticalStackLayout>
                        </Frame>

                        <!-- Recent Activity -->
                        <Frame BorderColor="LightGray"
                               CornerRadius="8"
                               Padding="15">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Recent Activity"
                                               FontSize="18"
                                               FontAttributes="Bold"/>
                                        <Label Text="No recent activity"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                </VerticalStackLayout>
                        </Frame>

                </VerticalStackLayout>
        </ScrollView>

</ContentPage>
