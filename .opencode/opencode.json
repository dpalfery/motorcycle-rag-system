{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "agent": {
        "explore": {
            "model": "opencode/deepseek-v4-flash-free",
            "reasoningEffort": "low"
        },
        "general": {
            "model": "opencode/deepseek-v4-flash-free",
            "reasoningEffort": "high"
        }
    },
    "provider": {
        "zai-coding-plan": {
            "models": {
                "glm-5.2": {
                    "name": "GLM 5.2"
                }
            }
        },
        "wafer": {
            "models": {
                "kimi-k2.6": {
                    "name": "Kimi K2.6"
                },
                "MiniMax-M3": {
                    "name": "MiniMax M3"
                },
                "glm-5.2": {
                    "name": "GLM 5.2"
                }
            }
        }
    },
    "permission": {
        "skill": {
            "*": "allow"
        },
        "bash": {
            "*": "allow"
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "azure-mcp": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@azure/mcp@latest",
                "server",
                "start"
            ]
        },
        "github": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
            }
        },
        "microsoft-learn": {
            "type": "remote",
            "url": "https://learn.microsoft.com/api/mcp"
        }
    }
}