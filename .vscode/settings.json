    "github.copilot.completions.chat.enabled": true,
    "github.copilot.chat.claudeAgent.allowAutoPermissions": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.agent.longToolCallCachePreservation.enabled": true,
    "github.copilot.chat.anthropic.promptCaching.extendedTtl": true,
    "github.copilot.chat.anthropic.promptCaching.extendedTtlMessages": true,
    "github.copilot.chat.cli.autoCommit.enabled": false,
    "inlineChat.defaultModel": "Auto (copilot)"
