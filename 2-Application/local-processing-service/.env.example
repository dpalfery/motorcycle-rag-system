# Environment variables for motorcycle-rag-local-processing
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# Azure Blob Storage — use account URL + DefaultAzureCredential (production & local)
AZURE_STORAGE_ACCOUNT_URL=https://mcrragdevst0125c2ea3c.blob.core.windows.net
BLOB_CONTAINER_UPLOADS=uploads
BLOB_CONTAINER_SEARCH_CHUNKS=search-chunks
BLOB_CONTAINER_GRAPH_ENTITIES=graph-entities

# Local dev fallback only — only used when AZURE_STORAGE_ACCOUNT_URL is not set
# AZURE_STORAGE_CONNECTION_STRING=

# CORS — set to the .NET API origin
ALLOWED_ORIGINS=http://localhost:5000

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_EMBEDDING=qwen3-embedding:4b
OLLAMA_MODEL_LLM=qwen3:4b

# Service configuration
PROCESSING_TIMEOUT_MINUTES=360
MAX_CHUNK_SIZE_TOKENS=512
MIN_CHUNK_SIZE_TOKENS=100
CHUNK_OVERLAP_TOKENS=50
SIMILARITY_THRESHOLD=0.8

# Logging
LOG_LEVEL=INFO
