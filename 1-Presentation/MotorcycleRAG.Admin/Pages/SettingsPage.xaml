<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.SettingsPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings">

       <ScrollView>
              <VerticalStackLayout Padding="20"
                            Spacing="15">

                     <!-- Page Header -->
                     <Label Text="Application Settings"
                            FontSize="24"
                            FontAttributes="Bold"
                            Margin="0,0,0,10"/>

                     <!-- Status Message -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="4"
                            Padding="10"
                            IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}">
                            <Label Text="{Binding StatusMessage}"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"/>
                     </Frame>

                     <!-- API Configuration Section -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15">
                            <VerticalStackLayout Spacing="10">
                                   <Label Text="API Configuration"
                                          FontSize="18"
                                          FontAttributes="Bold"/>
                                   <Label Text="Configure the connection to the Motorcycle RAG API server."
                                          FontSize="12"
                                          TextColor="Gray"/>

                                   <!-- API Base URL -->
                                   <Label Text="API Base URL"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding ApiBaseUrl}"
                                          Placeholder="https://your-api-server.com"
                                          Keyboard="Url"/>
                                   <Label Text="{Binding ApiValidationMessage}"
                                          FontSize="12"
                                          TextColor="{Binding IsApiValid, Converter={StaticResource BoolToColorConverter}}"/>

                                   <!-- Test Connection Button -->
                                   <HorizontalStackLayout Spacing="10">
                                          <Button Text="Test Connection"
                                                  Command="{Binding TestApiConnectionCommand}"
                                                  BackgroundColor="{StaticResource Secondary}"
                                                  TextColor="White"
                                                  Padding="15,8"
                                                  FontSize="12"
                                                  CornerRadius="4"
                                                  IsEnabled="{Binding IsTestingApi, Converter={StaticResource InverseBoolConverter}}"/>
                                          <ActivityIndicator IsRunning="{Binding IsTestingApi}"
                                                             IsVisible="{Binding IsTestingApi}"
                                                             HeightRequest="20"
                                                             WidthRequest="20"
                                                             VerticalOptions="Center"/>
                                   </HorizontalStackLayout>
                                   <Label Text="{Binding ApiTestResult}"
                                          FontSize="12"
                                          TextColor="Gray"
                                          IsVisible="{Binding ApiTestResult, Converter={StaticResource StringToBoolConverter}}"/>
                            </VerticalStackLayout>
                     </Frame>

                     <!-- Authentication Configuration Section -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15">
                            <VerticalStackLayout Spacing="10">
                                   <Label Text="Authentication Configuration"
                                          FontSize="18"
                                          FontAttributes="Bold"/>
                                   <Label Text="Configure Microsoft Entra ID / Azure AD authentication credentials."
                                          FontSize="12"
                                          TextColor="Gray"/>

                                   <!-- Client ID -->
                                   <Label Text="Admin App Client ID"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding AuthClientId}"
                                          Placeholder="00000000-0000-0000-0000-000000000000"
                                          IsPassword="False"/>

                                   <!-- Authority -->
                                   <Label Text="Authority URL"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding AuthAuthority}"
                                          Placeholder="https://login.microsoftonline.com/your-tenant-id"
                                          Keyboard="Url"/>

                                   <!-- API Scope -->
                                   <Label Text="Target API Scope"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding AuthScope}"
                                          Placeholder="api://your-api-client-id/admin"/>

                                   <!-- Validation Message -->
                                   <Label Text="{Binding AuthValidationMessage}"
                                          FontSize="12"
                                          TextColor="{Binding IsAuthValid, Converter={StaticResource BoolToColorConverter}}"/>
                            </VerticalStackLayout>
                     </Frame>

                     <!-- Local Processing Configuration Section -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15">
                            <VerticalStackLayout Spacing="10">
                                   <Label Text="Local Processing (Optional)"
                                          FontSize="18"
                                          FontAttributes="Bold"/>
                                   <Label Text="Configure the embedding provider endpoint and select a discovered model for local processing."
                                          FontSize="12"
                                          TextColor="Gray"/>

                                   <Label Text="Embedding Provider Endpoint"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Grid ColumnDefinitions="*,Auto"
                                                 ColumnSpacing="10">
                                          <Entry Grid.Column="0"
                                                 Text="{Binding EmbeddingProviderEndpoint}"
                                                 Placeholder="http://localhost:5272"
                                                 Keyboard="Url"/>
                                          <Button Grid.Column="1"
                                                  Text="Load Models"
                                                  Command="{Binding LoadEmbeddingModelsCommand}"
                                                  BackgroundColor="{StaticResource Secondary}"
                                                  TextColor="White"
                                                  Padding="15,8"
                                                  FontSize="12"
                                                  CornerRadius="4"
                                                  IsEnabled="{Binding IsLoadingEmbeddingModels, Converter={StaticResource InverseBoolConverter}}"/>
                                   </Grid>
                                   <ActivityIndicator IsRunning="{Binding IsLoadingEmbeddingModels}"
                                                      IsVisible="{Binding IsLoadingEmbeddingModels}"
                                                      HeightRequest="20"
                                                      WidthRequest="20"
                                                      HorizontalOptions="Start"/>
                                   <Label Text="{Binding EmbeddingProvider, StringFormat='Detected provider: {0}'}"
                                          FontSize="12"
                                          TextColor="Gray"
                                          IsVisible="{Binding EmbeddingProvider, Converter={StaticResource StringToBoolConverter}}"/>
                                   <Label Text="{Binding EmbeddingModelsStatusMessage}"
                                          FontSize="12"
                                          TextColor="Gray"
                                          IsVisible="{Binding EmbeddingModelsStatusMessage, Converter={StaticResource StringToBoolConverter}}"/>

                                   <Label Text="Embedding Model"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Picker ItemsSource="{Binding EmbeddingModels}"
                                           SelectedItem="{Binding EmbeddingModel}"
                                           Title="Select an embedding model"/>

                                   <Label Text="Local Processor Endpoint"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding LocalProcessorEndpoint}"
                                          Placeholder="http://localhost:8100"
                                          Keyboard="Url"/>

                                   <Label Text="Local Processor Working Directory"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding LocalProcessorWorkingDirectory}"
                                          Placeholder="D:\path\to\local-processing-service"/>

                                   <Label Text="Local Processor Start Command"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding LocalProcessorStartCommand}"
                                          Placeholder="py -3 src/main.py"/>

                                   <Label Text="PDF Chunk Size (tokens)"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding PdfChunkerMaxTokens}"
                                          Keyboard="Numeric"
                                          Placeholder="512"/>

                                   <Label Text="CSV Chunk Size (tokens)"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding CsvChunkMaxTokens}"
                                          Keyboard="Numeric"
                                          Placeholder="512"/>

                                   <Label Text="PDF Chunker Tokenizer"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding PdfChunkerTokenizer}"
                                          Placeholder="BAAI/bge-small-en-v1.5"/>

                                   <Label Text="Local Processor Upload Secret"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          Margin="0,10,0,0"/>
                                   <Entry Text="{Binding LocalProcessorUploadJobSecret}"
                                          Placeholder="Client secret for processor artifact uploads"
                                          IsPassword="True"/>

                                   <Label Text="{Binding LocalProcessorValidationMessage}"
                                          FontSize="12"
                                          TextColor="{Binding IsLocalProcessorValid, Converter={StaticResource BoolToColorConverter}}"/>
                            </VerticalStackLayout>
                     </Frame>

                     <!-- Diagnostics Section -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15">
                            <VerticalStackLayout Spacing="10">
                                   <Label Text="Diagnostics"
                                          FontSize="18"
                                          FontAttributes="Bold"/>
                                   <Label Text="Application logs are written to a rolling daily file. Open the folder to access them for troubleshooting."
                                          FontSize="12"
                                          TextColor="Gray"/>
                                   <Label Text="{Binding LogFolderPath}"
                                          FontSize="11"
                                          TextColor="Gray"
                                          LineBreakMode="MiddleTruncation"/>
                                   <Button Text="Open Log Folder"
                                           Command="{Binding OpenLogFolderCommand}"
                                           BackgroundColor="{StaticResource Primary}"
                                           TextColor="White"
                                           Padding="15,8"
                                           FontSize="12"
                                           HorizontalOptions="Start"/>
                            </VerticalStackLayout>
                     </Frame>

                     <!-- Action Buttons -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15">
                            <HorizontalStackLayout Spacing="15"
                                          HorizontalOptions="End">
                                   <Button Text="Reset All"
                                           Command="{Binding ResetSettingsCommand}"
                                           BackgroundColor="#FF6B6B"
                                           TextColor="White"
                                           Padding="20,10"
                                           FontSize="14"
                                           CornerRadius="4"/>
                                   <Button Text="Save Settings"
                                           Command="{Binding SaveSettingsCommand}"
                                           BackgroundColor="{StaticResource Primary}"
                                           TextColor="White"
                                           Padding="20,10"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           CornerRadius="4"/>
                                   <ActivityIndicator IsRunning="{Binding IsSaving}"
                                                      IsVisible="{Binding IsSaving}"
                                                      HeightRequest="24"
                                                      WidthRequest="24"
                                                      VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                     </Frame>

                     <!-- Unsaved Changes Indicator -->
                     <Label Text="You have unsaved changes"
                            FontSize="12"
                            TextColor="Orange"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasUnsavedChanges}"/>

                     <!-- Help Text -->
                     <Frame BorderColor="LightGray"
                            CornerRadius="8"
                            Padding="15"
                            BackgroundColor="#F8F8F8">
                            <VerticalStackLayout Spacing="5">
                                   <Label Text="Note"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                   <Label Text="Authentication credentials are stored securely on this device. Saved API and local processor settings are used by the landing page and jobs page."
                                          FontSize="12"
                                          TextColor="Gray"
                                          LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                     </Frame>

              </VerticalStackLayout>
       </ScrollView>

</ContentPage>
