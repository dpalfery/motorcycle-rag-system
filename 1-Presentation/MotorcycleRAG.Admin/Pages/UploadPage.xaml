<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.UploadPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:IngestionViewModel"
             Title="Upload and Process">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Manual PDF Upload" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Upload a large motorcycle service manual PDF for local chunking, embedding, and search ingestion. The backend will queue a local processor job for this document."
                           FontSize="12"
                           TextColor="Gray" />

                    <Button Text="Choose PDF"
                            Command="{Binding SelectFileCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" />

                    <Label Text="{Binding SelectedFilePath}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           IsVisible="{Binding SelectedFilePath, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Label Text="Supported format: PDF"
                           FontSize="11"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Upload and Queue Local Ingestion"
                    Command="{Binding ProcessFileCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsEnabled="{Binding CanProcessFile}" />

            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15"
                   IsVisible="{Binding IsProcessing}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Processing..." FontSize="16" FontAttributes="Bold" />

                    <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}"
                                 ProgressColor="{StaticResource Primary}" />

                    <Label Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}"
                           HorizontalOptions="End" />

                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Upload History" FontSize="18" FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding ProcessedFiles}"
                                    EmptyView="No uploads yet">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="LightGray" Margin="0,5" Padding="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding FileName}"
                                               FontAttributes="Bold" />
                                        
                                        <Label FontSize="11">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Status: {0} | Job ID: {1}">
                                                    <Binding Path="Status" />
                                                    <Binding Path="ExecutionId" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        
                                        <Label Text="{Binding Metadata}"
                                               FontSize="10"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
