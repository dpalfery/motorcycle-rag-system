{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "kyber-weave": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "7-Deployment/tools/KyberWeave/src/KyberWeave.Mcp",
        "-v",
        "q",
        "--",
        "--repo-root",
        "."
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "github": {
      "type": "http",
      "serverUrl": "https://api.githubcopilot.com/mcp/"
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}