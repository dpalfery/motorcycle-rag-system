{
    "cursor.autocomplete.enabled": true,
    "cursor.chat.enabled": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.postCommitCommand": "sync",
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "git.autofetch": true,
    "git.autofetchPeriod": 180,
    "kiroAgent.configureMCP": "Enabled",
    "zencoder.mcpServers": {
        "microsoft-learn": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp",
            "tools": [
                "*"
            ]
        }
    },
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    "chat.useNestedAgentsMdFiles": true,
    "github.copilot.chat.cli.customAgents.enabled": true,
    "github.copilot.chat.customAgents.showOrganizationAndEnterpriseAgents": true,
    "chat.useAgentSkills": true,
    "chat.customAgentInSubagent.enabled": true,
    "github.copilot.chat.cli.mcp.enabled": true,
    "chat.agentSessionsViewLocation": "view",
    "chat.viewSessions.enabled": true,
    "inlineChat.enableV2": true,
    "chat.viewSessions.orientation": "stacked",
    "specstory.cloudSync.enabled": "always",
    "specstory.derivedRules.enabled": true,
    "airun.settings": {
        "workspaceId": "926a5f0b-21d8-4aee-8742-9052005f81d3"
    },
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "terminal.integrated.env.windows": {
        "AZURE_CONFIG_DIR": "${workspaceFolder}/.azure-local"
    },
    "terminal.integrated.env.osx": {
        "AZURE_CONFIG_DIR": "${workspaceFolder}/.azure-local"
    },
    "terminal.integrated.env.linux": {
        "AZURE_CONFIG_DIR": "${workspaceFolder}/.azure-local"
    },
    "maui.configuration.useLaunchJsonConfigurations": true,
    "json.schemaDownload.allowList": [
        "https://opencode.ai/config.json"
    ],
    "chat.agentSkillsLocations": {
        ".claude/skills": false,
        ".agents/skills": false,
        "~/.agents/skills": false,
        "~/.claude/skills": false
    },
    "chat.experimental.useSkillAdherencePrompt": true,
    "github.copilot.chat.skillTool.enabled": true,
    "jsts-chat-features.skills.enabled": true
}