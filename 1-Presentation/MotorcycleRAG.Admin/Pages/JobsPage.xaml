<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorcycleRAG.Admin.Pages.JobsPage"
             Title="Pipeline Jobs">

    <Grid RowDefinitions="Auto,*" Padding="20">
        
        <!-- Header with Refresh Button -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <Label Text="Pipeline Executions" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Start" />
            
            <Button Text="Refresh" 
                    Clicked="OnRefreshClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HorizontalOptions="End" />
        </HorizontalStackLayout>

        <!-- Jobs List -->
        <ScrollView Grid.Row="1">
            <CollectionView x:Name="JobsCollectionView">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                        <Label Text="No pipeline executions found" 
                               FontSize="16" 
                               HorizontalOptions="Center" />
                        <Label Text="Configure authentication to load jobs from the API" 
                               FontSize="12" 
                               TextColor="Gray" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" 
                               Margin="0,5" 
                               Padding="15"
                               CornerRadius="8">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                  ColumnDefinitions="*,Auto">
                                
                                <!-- Execution ID and Status -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding ExecutionId}" 
                                           FontAttributes="Bold" 
                                           FontSize="14" />
                                    
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding PipelineType}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                        <Label Text="|" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                        <Label Text="{Binding Status}" 
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Cancel Button (visible only for running jobs) -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Text="Cancel"
                                        Clicked="OnCancelClicked"
                                        CommandParameter="{Binding ExecutionId}"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        FontSize="11"
                                        Padding="10,5"
                                        IsVisible="{Binding IsRunning}" />

                                <!-- Timestamps -->
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="3" Margin="0,10,0,0">
                                    <Label FontSize="11" TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Started: {0:g}">
                                                <Binding Path="StartTime" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    
                                    <Label FontSize="11" TextColor="Gray"
                                           IsVisible="{Binding EndTime, Converter={StaticResource HasValueConverter}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Ended: {0:g}">
                                                <Binding Path="EndTime" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Created By -->
                                <Label Grid.Row="2" Grid.ColumnSpan="2" 
                                       Text="{Binding CreatedBy, StringFormat='Created by: {0}'}" 
                                       FontSize="10" 
                                       TextColor="Gray"
                                       Margin="0,5,0,0" />

                                <!-- Errors and Warnings -->
                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0"
                                                     IsVisible="{Binding HasErrors}">
                                    <Label Text="Errors:" 
                                           FontSize="11" 
                                           TextColor="Red" 
                                           FontAttributes="Bold" />
                                    
                                    <CollectionView ItemsSource="{Binding Errors}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding .}" 
                                                       FontSize="10" 
                                                       TextColor="Red" 
                                                       Margin="10,0,0,2" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="5" Margin="0,5,0,0"
                                                     IsVisible="{Binding HasWarnings}">
                                    <Label Text="Warnings:" 
                                           FontSize="11" 
                                           TextColor="Orange" 
                                           FontAttributes="Bold" />
                                    
                                    <CollectionView ItemsSource="{Binding Warnings}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding .}" 
                                                       FontSize="10" 
                                                       TextColor="Orange" 
                                                       Margin="10,0,0,2" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </Grid>

</ContentPage>
