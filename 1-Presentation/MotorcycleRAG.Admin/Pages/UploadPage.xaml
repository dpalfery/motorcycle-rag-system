<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MotorcycleRAG.Admin.ViewModels"
             x:Class="MotorcycleRAG.Admin.Pages.UploadPage"
             x:ClassModifier="Internal"
             x:DataType="viewmodels:IngestionViewModel"
             Title="Manual Ingestion">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">

            <!-- PDF Upload -->
            <Frame BorderColor="LightGray"
                    CornerRadius="8"
                    Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Manual PDF Upload"
                            FontSize="20"
                            FontAttributes="Bold"/>
                    <Label Text="Upload a large motorcycle service manual PDF for local chunking, embedding, and search ingestion. The PDF is uploaded to the backend, queued for processing, and tracked as a canonical document."
                           FontSize="12"
                           TextColor="Gray"/>

                    <Button Text="Choose PDF"
                            Command="{Binding SelectFileCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"/>

                    <Label Text="{Binding SelectedFilePath}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           IsVisible="{Binding SelectedFilePath, Converter={StaticResource StringNotEmptyConverter}}"/>

                    <Label Text="Supported format: PDF (up to 100 MB)"
                           FontSize="11"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Upload and Queue Local Ingestion"
                    Command="{Binding ProcessFileCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsEnabled="{Binding CanProcessFile}"/>

            <!-- Upload Progress -->
            <Frame BorderColor="LightGray"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding IsProcessing}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Uploading and Queuing..."
                            FontSize="16"
                            FontAttributes="Bold"/>

                    <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}"
                                 ProgressColor="{StaticResource Primary}"/>

                    <Label Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}"
                           HorizontalOptions="End"/>

                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Document Registration Result (shown after successful upload) -->
            <Frame BorderColor="#D9A441"
                    CornerRadius="8"
                    Padding="15"
                    BackgroundColor="#332813"
                    IsVisible="{Binding HasDocumentResult}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Document Registered"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FFD27A"/>
                    <Label Text="{Binding DocumentId, StringFormat='Document ID: {0}'}"
                           FontSize="12"
                           TextColor="#FFD27A"/>
                    <Label Text="{Binding UploadId, StringFormat='Upload ID: {0}'}"
                           FontSize="12"
                           TextColor="#FFD27A"/>
                    <Label Text="{Binding DocumentJobId, StringFormat='Ingestion Job: {0}'}"
                           FontSize="12"
                           TextColor="#FFD27A"/>
                    <Label Text="{Binding DocumentFileName, StringFormat='Canonical source: {0}'}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           TextColor="#FFD27A"/>
                    <Label Text="The canonical PDF is stored in the backend and tracked as a first-class document. Processing runs and stage progress can be monitored from the Jobs page."
                           FontSize="11"
                           TextColor="#CC9900"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Document Processing Stages (for current document) -->
            <Frame BorderColor="LightGray"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding HasDocumentResult}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Processing Stages"
                               FontSize="18"
                               FontAttributes="Bold"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Command="{Binding RefreshDocumentStatusCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontSize="11"
                                Padding="12,6"/>
                    </Grid>

                    <Label Text="Stage-by-stage processing progress for the current document. Stage data is reported by the local processor as it completes each step."
                           FontSize="12"
                           TextColor="Gray"/>

                    <CollectionView ItemsSource="{Binding DocumentStages}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="8"
                                                 Padding="10">
                                <Label Text="Stage progress will appear after the ingestion job starts processing."
                                       FontSize="13"
                                       TextColor="Gray"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DocumentStageViewModel">
                                <HorizontalStackLayout Spacing="10"
                                                       Padding="5">
                                    <Frame WidthRequest="12"
                                           HeightRequest="12"
                                           CornerRadius="6"
                                           BackgroundColor="{Binding StageColor}"
                                           VerticalOptions="Center"
                                           Padding="0"
                                           HasShadow="False"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding StageName}"
                                               FontSize="13"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding StatusDetail}"
                                               FontSize="11"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>
                                    <Label Text="{Binding CompletedAtLabel}"
                                           FontSize="10"
                                           TextColor="Gray"
                                           HorizontalOptions="EndAndExpand"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Reprocess/Resume actions (placeholder for future API support) -->
                    <BoxView HeightRequest="1"
                             Opacity="0.2"/>
                    <Label Text="Reprocess / Resume"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Gray"/>
                    <Label Text="Re-run from a selected stage controls will become available once the API supports stage-level resume operations."
                           FontSize="11"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Upload History -->
            <Frame BorderColor="LightGray"
                    CornerRadius="8"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Upload History"
                            FontSize="18"
                            FontAttributes="Bold"/>

                    <CollectionView ItemsSource="{Binding ProcessedFiles}"
                                    EmptyView="No uploads yet">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="LightGray"
                                        Margin="0,5"
                                        Padding="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding FileName}"
                                               FontAttributes="Bold"/>

                                        <Label FontSize="11"
                                               TextColor="Gray">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Status: {0} | Job ID: {1}">
                                                    <Binding Path="Status"/>
                                                    <Binding Path="ExecutionId"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                        <Label Text="{Binding Metadata}"
                                               FontSize="10"
                                               TextColor="Gray"/>

                                        <HorizontalStackLayout Spacing="15"
                                                               IsVisible="{Binding HasProcessingMetrics}"
                                                               Margin="0,5,0,0">
                                            <Label Text="{Binding ChunkCount, StringFormat='Chunks: {0}'}"
                                                   FontSize="10"
                                                   TextColor="Gray"/>
                                            <Label Text="{Binding EmbeddingCount, StringFormat='Embeddings: {0}'}"
                                                   FontSize="10"
                                                   TextColor="Gray"/>
                                            <Label Text="{Binding ProcessingDurationLabel}"
                                                   FontSize="10"
                                                   TextColor="Gray"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>