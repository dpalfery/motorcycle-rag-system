{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.ApplicationInsights": "Warning",
      "Azure": "Warning"
    }
  },
  "AllowedHosts": "localhost,127.0.0.1,::1",
  "Cors": {
    "AllowedOrigins": "https://localhost:3000"
  },
  "ConnectionStrings": {
    "ApplicationInsights": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Authentication": {
    "Issuers": {
      "Workforce": "",
      "ExternalId": ""
    },
    "Audience": "",
    "ValidateLifetime": true,
    "ClockSkewSeconds": 300,
    "ValidateIssuerSigningKey": true
  },
  "Jwt": {
    "ValidAudience": "",
    "ValidIssuer": "",
    "IssuerSigningKeyUrl": ""
  },
  "AzureAI": {
    "FoundryEndpoint": "",
    "OpenAIEndpoint": "",
    "SearchServiceEndpoint": "",
    "DocumentIntelligenceEndpoint": "",
    "Models": {
      "ChatModel": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-large",
      "QueryPlannerModel": "gpt-4o",
      "VisionModel": "gpt-4-vision-preview",
      "MaxTokens": 4096,
      "Temperature": 0.1,
      "TopP": 1.0
    },
    "Retry": {
      "MaxRetries": 3,
      "BaseDelaySeconds": 2,
      "MaxDelaySeconds": 60,
      "UseExponentialBackoff": true
    }
  },
  "Search": {
    "IndexName": "motorcycle-index",
    "BatchSize": 100,
    "MaxSearchResults": 50,
    "EnableHybridSearch": true,
    "EnableSemanticRanking": true
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING}",
    "EnableTelemetry": true,
    "EnablePerformanceCounters": true,
    "ApplicationName": "MotorcycleRAG"
  },
  "Resilience": {
    "CircuitBreaker": {
      "OpenAI": {
        "FailureThreshold": 5,
        "SamplingDuration": "00:01:00",
        "MinimumThroughput": 10
      },
      "Search": {
        "FailureThreshold": 3,
        "SamplingDuration": "00:01:00",
        "MinimumThroughput": 5
      },
      "DocumentIntelligence": {
        "FailureThreshold": 3,
        "SamplingDuration": "00:01:00",
        "MinimumThroughput": 5
      }
    },
    "Retry": {
      "MaxRetries": 3,
      "BaseDelaySeconds": 2,
      "MaxDelaySeconds": 60,
      "UseExponentialBackoff": true
    },
    "Fallback": {
      "EnableCachedResponses": true,
      "EnableSimplifiedSearch": true,
      "EnableOfflineMode": false,
      "CacheExpiration": "00:30:00",
      "FallbackMessage": "Service temporarily unavailable. Using cached or simplified results."
    }
  },
  "Pipeline": {
    "MaxConcurrentExecutions": 3,
    "DefaultTimeout": "00:30:00",
    "MaxRetries": 3,
    "TempDirectory": "temp",
    "EnableDetailedLogging": true
  },
  "FileUpload": {
    "BaseUploadDirectory": "uploads",
    "MaxFileSizeBytes": 52428800,
    "MaxFilesPerBatch": 10,
    "EnableVirusScanning": false,
    "AllowedExtensions": [
      ".csv",
      ".pdf"
    ],
    "AllowedContentTypes": [
      "text/csv",
      "application/csv",
      "application/pdf"
    ]
  },
  "PipelineMonitoring": {
    "AlertsEnabled": true,
    "FailureRateThreshold": 0.10,
    "LongRunningThreshold": "00:30:00",
    "ConsecutiveFailuresThreshold": 3,
    "MaxActiveExecutions": 10,
    "MaxRecentExecutions": 1000,
    "DefaultEmailRecipients": []
  },
  "ScheduledProcessing": {
    "DefaultCronExpression": "0 2 * * *",
    "IsEnabledByDefault": true,
    "DefaultProcessingWindow": "04:00:00",
    "DefaultMaxConcurrentJobs": 3,
    "BaseDirectory": "data"
  },
  "Cache": {
    "MaxCacheEntries": 10000,
    "DefaultExpiration": "01:00:00",
    "SlidingExpiration": "00:30:00",
    "EnableDistributedCache": false
  }
}